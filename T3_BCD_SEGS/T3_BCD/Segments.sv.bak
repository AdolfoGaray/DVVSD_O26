module Segments (
	input logic [3:0] num,
	output logic [6:0] segs
);

always_comb begin
	case(num)
		4'b0000: segs = 7'b1110111;
		4'b0001: segs = 7'b1100000;
		4'b0010: segs = 7'b1011101;
		4'b0011: segs = 7'b1111100;
		4'b0100: segs = 7'b1101010;
		4'b0101: segs = 7'b0111110;
		4'b0110: segs = 7'b0111111;
		4'b0111: segs = 7'b1110000;
		4'b1000: segs = 7'b1111111;
		4'b1001: segs = 7'b1111010;
		4'b1010: segs = 7'b1111011;
		4'b1011: segs = 7'b0101111;
		4'b1100: segs = 7'b0001101;
		4'b1101: segs = 7'b1101101;
		4'b1110: segs = 7'b0011111;
		4'b1111: segs = 7'b0011011;
		default: segs = 7'b0000000;
	endcase
end

endmodule